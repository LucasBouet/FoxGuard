[Unit]
Description=Foxguard gateway agent (nftables + WireGuard + DNS reconciliation)
Documentation=https://github.com/your-org/foxguard
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/foxguard/agent.env
ExecStart=/opt/foxguard/venv/bin/foxguard-agent
Restart=always
RestartSec=5

# The agent needs to program nftables and WireGuard, and nothing else.
# Running as root with a reduced capability set is simpler and safer here than
# a dedicated user that would need CAP_NET_ADMIN granted anyway.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# ProtectSystem=strict makes the whole filesystem read-only, so every path the
# agent writes has to be named here. /etc/foxguard/dns is where it renders the
# resolver's zone; without it DNS reconciliation fails with EROFS on a box where
# everything else works.
#
# The dns and proxy directories are prefixed with `-` because the installer only
# creates them for the features you enabled. Without the prefix a path that does
# not exist is fatal: the agent dies at 226/NAMESPACE before it runs a line of
# Python, so a --no-dns --no-proxy install produces an agent that cannot start
# at all. The prefix means "skip it if it is absent" -- enable a feature later
# and the directory appears, but this unit has to be restarted to see it.
ReadWritePaths=/var/lib/foxguard -/etc/foxguard/dns -/etc/foxguard/proxy
# /run/foxguard holds HAProxy's runtime socket, which the agent connects to for
# seamless reloads. Declared here and not only in foxguard-proxy.service: the
# directory used to exist solely because that unit created it, so the agent
# could not start unless the proxy had started first, and stopping the proxy
# deleted the directory out from under a running agent. Preserve=yes stops the
# other unit's shutdown from taking it away; /run is tmpfs, so a reboot still
# clears it.
RuntimeDirectory=foxguard
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
