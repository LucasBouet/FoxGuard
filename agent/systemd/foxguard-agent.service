[Unit]
Description=Foxguard gateway agent (nftables + WireGuard reconciliation)
Documentation=https://github.com/your-org/foxguard
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/foxguard/agent.env
ExecStart=/opt/foxguard/venv/bin/foxguard-agent
Restart=always
RestartSec=5

# The agent needs to program nftables and WireGuard, and nothing else.
# Running as root with a reduced capability set is simpler and safer here than
# a dedicated user that would need CAP_NET_ADMIN granted anyway.
User=root
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW
AmbientCapabilities=CAP_NET_ADMIN
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/foxguard
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
