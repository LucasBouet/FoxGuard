[Unit]
Description=Foxguard reverse proxy (HAProxy, published services)
Documentation=https://github.com/your-org/foxguard
# The internal listener binds the gateway's tunnel address, which does not
# exist until the interface is up. Without this the daemon fails to bind and
# systemd restarts it in a loop until wg-quick happens to win the race.
After=network-online.target wg-quick@wg0.service
Wants=network-online.target

[Service]
# Master-worker mode. This is what makes a reload seamless: the master keeps
# the listening sockets, hands them to a new worker, and the old worker drains
# its connections instead of dropping them. Measured on 3.0.11 -- a six-second
# response with the reload fired two seconds in still completed with 200.
Type=notify
Environment=CONFIG=/etc/foxguard/proxy/haproxy.cfg PIDFILE=/run/foxguard/haproxy.pid
ExecStartPre=/usr/sbin/haproxy -Ws -f $CONFIG -c -q
ExecStart=/usr/sbin/haproxy -Ws -f $CONFIG -p $PIDFILE
# Validate before signalling: a reload that fails leaves the master running the
# old configuration, but a validated one never gets that far.
ExecReload=/usr/sbin/haproxy -Ws -f $CONFIG -c -q
ExecReload=/bin/kill -USR2 $MAINPID
KillMode=mixed
Restart=on-failure
RestartSec=2
# Long, because draining a passthrough session can legitimately take a while
# and killing it defeats the point of the seamless reload above.
TimeoutStopSec=90

User=root
# CAP_NET_BIND_SERVICE for :80 and :443. Unlike foxguard-dns, HAProxy reads its
# configuration, pattern files and certificates *before* dropping privileges,
# so no ambient CAP_SETUID gymnastics are needed here.
CapabilityBoundingSet=CAP_NET_BIND_SERVICE CAP_SETUID CAP_SETGID
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# The runtime socket and the pid file live here. Without this systemd's
# ProtectSystem=strict makes /run read-only and the master cannot start.
RuntimeDirectory=foxguard
RuntimeDirectoryMode=0750
# Read-only: the configuration is written by foxguard-agent, never by HAProxy.
# The certificate directory is separate because certbot's deploy hook writes
# there, and it must not be writable by this unit either.
ReadOnlyPaths=/etc/foxguard/proxy
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
